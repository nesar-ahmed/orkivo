# Orkivo backend environment example
# Copy to .env for local development. Fake values only --- never commit real secrets
# (see architecture doc section 9.1).

# SQLite is the lightweight sandbox option. PostgreSQL remains the canonical
# target database; when running it via Docker Compose, use e.g.:
#   postgresql+psycopg://orkivo:orkivo@localhost:5432/orkivo
DATABASE_URL=sqlite:///./orkivo.db

ENVIRONMENT=development

# JSON list of allowed browser origins for CORS. The browser must reach the API
# on the same host name the dashboard is served from (localhost, not 127.0.0.1),
# or the session cookies below will not be attached.
CORS_ORIGINS=["http://localhost:3000"]

# --- Authentication -----------------------------------------------------
# HMAC signing secret for access tokens. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty here on purpose: in development a fresh ephemeral key is generated
# per process, so sessions end on restart. Outside development a value of at
# least 32 characters is REQUIRED and the app refuses to start without one.
SECRET_KEY=

# Access tokens are short-lived; refresh sessions are long-lived but stored
# hashed, rotated on every use, and revocable.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Session cookies are HttpOnly and SameSite=Lax. Set to true only when the API
# is served over https; unset means Secure everywhere except development.
# COOKIE_SECURE=true

# Cookies are host-only by default. Set a domain only to share them across
# subdomains.
# COOKIE_DOMAIN=.example.com

# The account allowed to claim the platform operator role. Registration always
# creates an ordinary account, so this is how the first operator is created: set
# it to an address you control, sign in once, then clear it. It grants nothing
# while any operator exists, and it never accepts a role from a request. An
# operator runs the platform console: tenant lists and lifecycle, never the
# content inside a tenant.
# FIRST_OPERATOR_EMAIL=admin@example.com
