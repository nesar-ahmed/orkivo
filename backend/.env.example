# Orkivo backend environment example
# Copy to .env for local development. Fake values only --- never commit real secrets
# (see architecture doc section 9.1).

# SQLite is the lightweight sandbox option. PostgreSQL remains the canonical
# target database; when running it via Docker Compose, use e.g.:
#   postgresql+psycopg://orkivo:orkivo@localhost:5432/orkivo
DATABASE_URL=sqlite:///./orkivo_dev.db

ENVIRONMENT=development

# JSON list of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]
